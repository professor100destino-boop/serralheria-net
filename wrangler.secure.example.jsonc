{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "serralheria-net",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-14",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "serralheria-net-db",
      "database_id": "SUBSTITUIR_PELO_ID_DO_D1"
    }
  ]
}
